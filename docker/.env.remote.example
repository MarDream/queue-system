TZ=Asia/Shanghai
BACKEND_PORT=8080
BACKEND_NETWORK_NAME=queue-shared
BACKEND_NETWORK_EXTERNAL=false

APP_PUBLIC_HOST=your-domain-or-server-ip
APP_FRONTEND_PORT=80
APP_FRONTEND_BASE_URL=https://your-domain.com
APP_CORS_EXTRA_ORIGINS=

DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=queue_system
DB_USERNAME=root
DB_PASSWORD=change-me

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=

MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=your-mail-account
MAIL_PASSWORD=your-mail-password-or-app-code
MAIL_PROTOCOL=smtp
MAIL_SMTP_AUTH=true
MAIL_SMTP_SSL_ENABLE=true
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_SOCKET_FACTORY_CLASS=javax.net.ssl.SSLSocketFactory
MAIL_SMTP_SOCKET_FACTORY_PORT=465

JWT_SECRET=change-me-with-at-least-32-characters
LOG_PATH=/app/logs

FRONTEND_DIST_DIR=/data/www/queue-system
NGINX_CONTAINER_NAME=
